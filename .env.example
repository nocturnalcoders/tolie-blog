# deploy/setup.sh creates the real .env for you. Never commit it.
POSTGRES_PASSWORD=generated
BLOG_SECRET_KEY=generated
BLOG_ADMIN_USER=admin
BLOG_ADMIN_HASH_B64=generated
BLOG_SITE_URL=https://blog.tolie.space

# Optional: a message for every new comment. Fill in either block (or both), then run deploy/deploy.sh.
# Telegram: talk to @BotFather, send /newbot, copy the token. Then send your bot any message and open
# https://api.telegram.org/bot<token>/getUpdates to find "chat":{"id": ...}.
BLOG_TELEGRAM_TOKEN=
BLOG_TELEGRAM_CHAT_ID=
# Email over SMTP (Gmail: smtp.gmail.com, port 587, and an App Password, not your normal password).
BLOG_SMTP_HOST=
BLOG_SMTP_PORT=587
BLOG_SMTP_USER=
BLOG_SMTP_PASSWORD=
BLOG_NOTIFY_EMAIL=
# The same SMTP settings also send "new note" emails to subscribers and reply emails to commenters.
# The sender address (defaults to BLOG_SMTP_USER). Use an address on your own domain if you can.
BLOG_MAIL_FROM=

# Optional: copy every backup off the droplet (deploy/backup.sh). Any S3-compatible storage works.
# DigitalOcean Spaces: create a Space (keep it private) and a Spaces access key, then e.g.
#   BACKUP_S3_ENDPOINT=sgp1.digitaloceanspaces.com   BACKUP_S3_BUCKET=<space name>
# No quotes around values.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=tolie-blog
BACKUP_KEEP_DAYS=30
