# Filled in by the nginx image at start-up (${...} values come from environment variables).
server {
    listen 80;
    server_name _;
    server_tokens off;
    client_max_body_size 16m;

    root /usr/share/nginx/html;
    index index.html;

    # Docker's built-in DNS. Resolving per request means a restarted API container
    # is found again without restarting nginx.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $api_upstream http://${API_HOST}:${API_PORT};

    # Everything the Python backend answers.
    location ~ ^/(api/|uploads/|og/|post/|feed\.xml$|sitemap\.xml$|robots\.txt$|healthz$) {
        include /etc/nginx/snippets/security.conf;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_read_timeout 30s;
    }

    # Built files have hashed names, so they can be cached for a year.
    location /assets/ {
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The React app (any other path falls back to index.html).
    location / {
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
